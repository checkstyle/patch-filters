<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="TreeWalker">
        <module name="FallThrough"/>

        <module name="com.puppycrawl.tools.checkstyle.filters.SuppressionJavaPatchFilter">
            <property name="file" value="${tp}/defaultContext.patch" />
            <property name="strategy" value="context" />
            <!--
                Uses the extended contextStrategy syntax with an explicit Checkstyle
                token type (LITERAL_SWITCH) instead of the generic ANCESTOR keyword.
                This eliminates the need for a hardcoded built-in map entry and allows
                any check (including custom ones) to specify its ancestor token type.
                This is the recommended replacement for the deprecated
                'checkNamesForContextStrategyByTokenOrAncestorSet' property.
            -->
            <property name="contextStrategy" value="FallThrough:LITERAL_SWITCH" />
        </module>
    </module>
</module>
